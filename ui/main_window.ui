          </property>
          <property name="styleSheet">
           <string notr="true">QPushButton#btnIzaberiKupca {
    background-color: #A9C5E2;
    color: white; /* Bela boja teksta */
    font-size: 20px; /* Veličina fonta */
    font-weight: bold; /* Podebljani tekst */
    border-style:outset;
	border-width:4px;
	border-color: #93afe2;
	border-radius:15px;
	padding:10px;
}
QPushButton#btnIzaberiKupca:hover {
    background-color: #b5d3f1; /* Svetlija zelena kad se prelazi mišem */
color: red; /* Crvena boja teksta */
font-size: 22px; /* Veličina fonta */
}
QPushButton#btnIzaberiKupca:pressed {
    background-color:#CEE5FD; /* Plava */
color: white; /* Crvena boja teksta */
font-size: 22px; /* Veličina fonta */
}</string>
