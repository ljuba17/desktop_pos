           </property>
           <property name="styleSheet">
            <string notr="true">QPushButton#btnKorpa {
	border-style:outset;
	background-color: rgb(107, 134, 134);
	color: white; /* Bela boja teksta */
	border-width:4px;
	border-radius:10px;
	border-color:#8aacac;
	padding:10px;
}
QPushButton#btnKorpa:hover {
   	background-color: rgb(127, 175, 176);
	color: white;
	font-size: 16px; /* Veličina fonta */
}
QPushButton#btnKorpa:pressed {
    background-color:#CEE5FD; /* Plava */
	color: white; /* Bela boja teksta */
}
QPushButton#btnKorpa:focus {
    border: 3px solid yellow;
    background-color: rgb(150, 180, 180);
    color: black;
    font-weight: bold;
}</string>
           </property>
